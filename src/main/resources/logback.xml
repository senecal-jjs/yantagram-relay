<configuration>
    <!-- Log events, never tags, tokens, IPs or bodies. Third-party libraries stay at
         WARN so their debug output (which can include request details) never reaches
         the logs. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{ISO8601} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.yantagram.relay" level="INFO"/>
    <logger name="io.ktor.server.Application" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
